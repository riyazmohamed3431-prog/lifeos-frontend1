{
  "name": "lifeos-monorepo",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "build": "npm run build --prefix frontend",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm --prefix backend start\" \"npm --prefix frontend start\""
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
